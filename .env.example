# UK Wind Forecast Dashboard — Environment Variables
# Copy this file to .env and adjust as needed
# Never commit .env to source control

# ── Backend ──────────────────────────────────────────────────────────────────

# Elexon BMRS API base URL (no trailing slash)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1

# Allowed CORS origins (comma-separated)
# In production, set to your actual frontend URL
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# HTTP request timeout in seconds for Elexon API calls
REQUEST_TIMEOUT_SECONDS=30

# Maximum number of retries for transient Elexon API failures
MAX_RETRIES=3

# Cache TTL for recent data (last 48 hours), in seconds
CACHE_TTL_SECONDS=300

# Cache TTL for historical data (older than 48 hours), in seconds
CACHE_TTL_HISTORICAL=3600

# Maximum days allowed for trend analysis
MAX_TREND_DAYS=30

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Assumed GB installed wind capacity in MW.
# This is NOT retrieved from Elexon — it is used only to calculate
# a display-only capacity factor. As of early 2026, GB installed
# onshore + offshore wind is approximately 30 GW.
# Source: DESNZ / DUKES annual statistics.
# Do not use this value as a substitute for actual electricity demand.
UK_INSTALLED_WIND_MW=30000

# ── Frontend ─────────────────────────────────────────────────────────────────

# Backend API base URL (used at build time by Vite)
# For local development: http://localhost:8000
# For Docker Compose: http://backend:8000
# For production: your Render backend URL
VITE_API_BASE_URL=http://localhost:8000
